# Binaries for the current project
# Compiled binaries, usually found in the current directory or a 'bin' directory.
*.exe
*.dll
*.so
*.dylib
*.bin
*/bin/

# Go module cache and build artifacts
# The Go module cache can be large and should not be committed.
# The 'pkg' directory contains compiled packages.
/pkg/
/vendor/ # If you are using explicit vendor directories (less common with Go modules)

# Test cache
# Go test cache can accumulate and should be ignored.
/go.test/

# IDE and Editor specific files
# Common files generated by various IDEs and editors.
.idea/ # IntelliJ IDEA
.vscode/ # VS Code
.DS_Store # macOS
Thumbs.db # Windows
*.sublime-project # Sublime Text
*.sublime-workspace # Sublime Text

# Log files and temporary files
*.log
*.tmp